@model IEnumerable<EmployeeDepartmentProject.Models.DepartmentViewModel>

@{
    ViewData["Title"] = "Index";
}

<style>
    body {
        background-color: lightgoldenrodyellow;
    }
</style>

<h1>Departments:</h1>

<p>
    <a asp-action="Create" class="btn btn-warning">Add Department</a>
</p>

@if (Model.Count() == 0)
{
    <div class="alert alert-warning">
        No departments in
    </div>
}
else
{
    <div class="row">
        <div class="col-md-5">
            <table class="table table-bordered">
                <thead>
                    <tr>
                        <th class="fw-bold">
                            @Html.DisplayNameFor(model => model.Id)
                        </th>
                        <th class="fw-bold">
                            @Html.DisplayNameFor(model => model.Name)
                        </th>
                        <th class="fw-bold">
                            @Html.DisplayNameFor(model => model.Code)
                        </th>
                        <th class="fw-bold">
                            Actions
                        </th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                @item.Id
                            </td>
                            <td>
                                @item.Name
                            </td>
                            <td>
                                @item.Code
                            </td>
                            <td class="col-4">
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-success">Edit</a>
                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger">Delete</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
