@page
@model LoginModel

@{
    ViewData["Title"] = "Log in";
}

<style>
    /* Card */
    .christmas-card {
        max-width: 420px;
        width: 100%;
        border-radius: 16px;
        border: 2px solid #c41e3a;
        background: linear-gradient(145deg, #ffffff, #f8f9fa);
    }

    /* Title */
    .christmas-title {
        color: #c41e3a;
        font-weight: 700;
    }

    /* Button */
    .christmas-btn {
        background-color: #1e7f3c;
        color: #fff;
        font-weight: 600;
        border-radius: 30px;
        padding: 12px;
        transition: all 0.3s ease;
    }

        .christmas-btn:hover {
            background-color: #166b32;
            color: #fff;
            transform: translateY(-1px);
        }

    /* Link */
    .christmas-link {
        color: #c41e3a;
        font-weight: 500;
        text-decoration: none;
    }

        .christmas-link:hover {
            text-decoration: underline;
        }

    /* Input focus */
    .form-control:focus {
        border-color: #1e7f3c;
        box-shadow: 0 0 0 0.2rem rgba(30, 127, 60, 0.25);
    }

    body {
        background: linear-gradient( to bottom right, #0f5132, #198754, #c41e3a );
    }
</style>

<div class="container d-flex justify-content-center align-items-center min-vh-100">
    <div class="card christmas-card shadow-lg">
        <div class="card-body p-4">
            <h1 class="text-center christmas-title mb-2">🎅 Welcome Back</h1>
            <p class="text-center text-muted mb-4">
                Log in and spread some holiday cheer
            </p>

            <form id="account" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="form-floating mb-3">
                    <input asp-for="Input.UserName"
                           class="form-control"
                           autocomplete="username"
                           aria-required="true" />
                    <label asp-for="Input.UserName">Username or Email</label>
                    <span asp-validation-for="Input.UserName" class="text-danger"></span>
                </div>

                <div class="form-floating mb-4">
                    <input asp-for="Input.Password"
                           class="form-control"
                           autocomplete="current-password"
                           aria-required="true" />
                    <label asp-for="Input.Password">Password</label>
                    <span asp-validation-for="Input.Password" class="text-danger"></span>
                </div>

                <button id="login-submit"
                        type="submit"
                        class="btn christmas-btn w-100 mb-3">
                    🎄 Log In
                </button>

                <div class="text-center">
                    <a asp-page="./Register"
                       asp-route-returnUrl="@Model.ReturnUrl"
                       class="christmas-link">
                        🎁 New here? Create an account
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
