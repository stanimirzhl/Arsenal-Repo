@page
@model RegisterModel
@{
    ViewData["Title"] = "Register";
}

<style>
    .christmas-card {
        max-width: 420px;
        width: 100%;
        border-radius: 16px;
        background: linear-gradient(145deg, #ffffff, #f8f9fa);
        border: 2px solid #c41e3a;
    }

    /* Title */
    .christmas-title {
        color: #c41e3a;
        font-weight: 700;
    }

    /* Button */
    .christmas-btn {
        background-color: #1e7f3c;
        color: #fff;
        font-weight: 600;
        border-radius: 30px;
        padding: 12px;
        transition: all 0.3s ease;
    }

        .christmas-btn:hover {
            background-color: #166b32;
            color: #fff;
            transform: translateY(-1px);
        }

    /* Inputs */
    .form-control:focus {
        border-color: #1e7f3c;
        box-shadow: 0 0 0 0.2rem rgba(30, 127, 60, 0.25);
    }

    /* Page background */
    body {
        background: linear-gradient( to bottom right, #0f5132, #198754, #c41e3a );
    }
</style>

<div class="container d-flex justify-content-center align-items-center min-vh-100">
    <div class="card christmas-card shadow-lg">
        <div class="card-body p-4">
            <h1 class="text-center christmas-title mb-3">🎄 Create Account</h1>
            <p class="text-center text-muted mb-4">Join the holiday spirit</p>

            <form id="registerForm" asp-route-returnUrl="@Model.ReturnUrl" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="form-floating mb-3">
                    <input asp-for="Input.Email" class="form-control" autocomplete="username" />
                    <label asp-for="Input.Email">Email</label>
                    <span asp-validation-for="Input.Email" class="text-danger"></span>
                </div>

                <div class="form-floating mb-3">
                    <input asp-for="Input.UserName" class="form-control" />
                    <label asp-for="Input.UserName">Username</label>
                    <span asp-validation-for="Input.UserName" class="text-danger"></span>
                </div>

                <div class="row">
                    <div class="col-md-6 form-floating mb-3">
                        <input asp-for="Input.FirstName" class="form-control" />
                        <label asp-for="Input.FirstName">First Name</label>
                        <span asp-validation-for="Input.FirstName" class="text-danger"></span>
                    </div>

                    <div class="col-md-6 form-floating mb-3">
                        <input asp-for="Input.LastName" class="form-control" />
                        <label asp-for="Input.LastName">Last Name</label>
                        <span asp-validation-for="Input.LastName" class="text-danger"></span>
                    </div>
                </div>

                <div class="form-floating mb-3">
                    <input asp-for="Input.Password" class="form-control" autocomplete="new-password" />
                    <label asp-for="Input.Password">Password</label>
                    <span asp-validation-for="Input.Password" class="text-danger"></span>
                </div>

                <div class="form-floating mb-4">
                    <input asp-for="Input.ConfirmPassword" class="form-control" autocomplete="new-password" />
                    <label asp-for="Input.ConfirmPassword">Confirm Password</label>
                    <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
                </div>

                <button type="submit" class="btn christmas-btn w-100">
                    🎁 Register
                </button>

                <div class="text-center">
                    <a asp-page="./Login"
                       asp-route-returnUrl="@Model.ReturnUrl"
                       class="christmas-link">
                        🎁 Have an account? Log in
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
