@model GiftViewModel

@{
    ViewData["Title"] = "Твоят подарък";
    var randomBox = new Random().Next(1, 4);
}

<style>
    body {
        background-color: #b30000;
        color: white;
        text-align: center;
    }

    .box-row {
        display: flex;
        justify-content: center;
        margin-top: 140px;
        gap: 40px;
    }

    .gift-box {
        width: 130px;
        height: 130px;
        background: #ff0000;
        position: relative;
        border-radius: 12px;
        box-shadow: 0 6px 20px rgba(0,0,0,0.4);
        cursor: pointer;
        transition: 0.5s ease;
        animation: bounce 2.2s ease-in-out infinite;
    }

    .gift-box::before {
        content: "";
        position: absolute;
        left: 50%;
        top: 0;
        width: 20px;
        height: 100%;
        background: gold;
        transform: translateX(-50%);
        border-radius: 3px;
    }

    .gift-box::after {
        content: "";
        position: absolute;
        top: 50%;
        left: 0;
        width: 100%;
        height: 20px;
        background: gold;
        transform: translateY(-50%);
        border-radius: 3px;
    }

    .gift-box.opened {
        background: #ffe6e6;
        transform: scale(1.2) rotate(6deg);
        box-shadow: 0 12px 30px rgba(255, 255, 255, 0.6);
        animation: pop 0.6s ease-out forwards;
    }

    .gift-content {
        display: none;
        margin-top: 40px;
        animation: fadeIn 1s ease-in-out forwards;
    }
</style>


<div class="box-row">
    <div class="gift-box" id="box1"></div>
    <div class="gift-box" id="box2"></div>
    <div class="gift-box" id="box3"></div>
</div>

<div class="gift-content" id="giftContent">
    <h2>🎁 Твоят подарък е:</h2>
    <h3>@Model.Name</h3>
    <p>@Model.Description</p>
    <img src="@Model.ImageUrl" style="width:220px; border-radius:10px;" />
    <p class="mt-3"><strong>Категория:</strong> @Model.CategoryName</p>
</div>

<script>
    const randomBox = @randomBox;

    document.addEventListener("DOMContentLoaded", () => {
        const box = document.getElementById("box" + randomBox);

        setTimeout(() => {
            box.classList.add("opened");

            setTimeout(() => {
                document.getElementById("giftContent").style.display = "block";
            }, 600);
        }, 800);
    });
</script>
