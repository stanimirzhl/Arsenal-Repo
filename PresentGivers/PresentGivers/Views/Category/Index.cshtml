@model IEnumerable<CategoryViewModel>

@{
    ViewData["Title"] = "Index";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="fw-bold">Категории</h2>
        <a class="btn btn-primary" asp-action="Create">
            <i class="bi bi-plus-circle"></i> Добави категория
        </a>
    </div>

    @if (Model.Any())
    {
        <div class="card shadow-sm">
            <div class="card-body p-0">
                <table class="table table-hover table-striped mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th>Име</th>
                            <th style="width: 200px;">Управление</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.Name</td>
                                <td>
                                    <div class="d-flex align-items-center">
                                        <a class="btn btn-sm btn-warning me-1" asp-action="Edit" asp-route-id="@item.Id">
                                            Редактирай
                                        </a>

                                        <form method="post" asp-action="Delete" asp-route-id="@item.Id">
                                            <button type="submit" class="btn btn-sm btn-danger">
                                                Изтрий
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
    else
    {
        <div class="card shadow-sm">
            <div class="card-body">
                <div class="alert alert-warning mb-0 text-center">
                    Няма добавени категории
                </div>
            </div>
        </div>
    }

</div>